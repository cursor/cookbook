diff --git a/test/api.test.js b/test/api.test.js
new file mode 100644
index 0000000..c700973
--- /dev/null
+++ b/test/api.test.js
@@ -0,0 +1,69 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { createServer } from "node:net";
+import { fileURLToPath } from "node:url";
+
+const SERVER = fileURLToPath(new URL("../server.js", import.meta.url));
+let server;
+let BASE;
+
+const freePort = () =>
+  new Promise((resolve) => {
+    const probe = createServer().listen(0, "127.0.0.1", () => {
+      const { port } = probe.address();
+      probe.close(() => resolve(port));
+    });
+  });
+
+before(async () => {
+  const port = await freePort();
+  BASE = `http://127.0.0.1:${port}`;
+  server = spawn(process.execPath, [SERVER], { env: { ...process.env, PORT: String(port), SEED: "0" } });
+  await new Promise((resolve, reject) => {
+    server.once("error", reject);
+    server.once("exit", (code) => reject(new Error(`server exited early with code ${code}`)));
+    server.stdout.on("data", (chunk) => {
+      if (String(chunk).includes("tasks-app on")) resolve();
+    });
+  });
+});
+
+after(() => server?.kill());
+
+const post = (body) =>
+  fetch(`${BASE}/api/tasks`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+
+const titles = async () => (await (await fetch(`${BASE}/api/tasks`)).json()).map((t) => t.title);
+
+async function assertRejected(body) {
+  const before = await titles();
+  const res = await post(body);
+  assert.equal(res.status, 400);
+  assert.match(res.headers.get("content-type") ?? "", /application\/json/);
+  assert.deepEqual(await res.json(), { error: "Title is required" });
+  assert.deepEqual(await titles(), before);
+}
+
+test("AC-1: rejects an empty title with 400 and creates no task", async () => {
+  await assertRejected({ title: "" });
+});
+
+test("AC-2: rejects a whitespace-only title with 400 and creates no task", async () => {
+  await assertRejected({ title: "   " });
+  await assertRejected({ title: " \t\n " });
+});
+
+test("AC-3: rejects a missing title with 400 and creates no task", async () => {
+  await assertRejected({});
+});
+
+test("still creates a task from a valid title", async () => {
+  const res = await post({ title: "  Ship it " });
+  assert.equal(res.status, 201);
+  assert.equal((await res.json()).title, "Ship it");
+});
