# Configuration for the AgentCore Runtime Instances target.
#
# This target is self-contained: copy this file to agentcore/.env and run make from the
# agentcore directory. The parent ../.env is not read.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Cursor self-hosted worker identity
# ---------------------------------------------------------------------------

# Must be a Cursor service account API key. User, member, team, personal, and
# organization keys do not work for pool workers.
#
# Used only by `make agentcore-put-api-key-secret`, which uploads it to Secrets
# Manager, and by `make agentcore-contract-test` for the optional live check. It
# never reaches Terraform state.
CURSOR_API_KEY=replace-with-service-account-api-key

CURSOR_WORKER_POOL_NAME=agentcore-platform-agents
CURSOR_WORKER_IDLE_RELEASE_TIMEOUT=600

# Secret container Terraform creates and the adapter reads at startup. AgentCore
# has no native secret injection, so the worker fetches the value itself using the
# runtime execution role.
CURSOR_API_KEY_SECRET_NAME=cursor-agentcore-worker-api-key

# Git remote the persistent workspace is initialized with. Cursor derives the repo
# label from this remote and worker startup fails without it. Required.
# Do not use this cookbook's origin. Use the application repo the agent should
# change. The lab sample is https://github.com/kaushalavardhanam/kaushalavardhanam.git
WORKER_REPOSITORY_URL=

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------

AWS_PROFILE=default

# AgentCore Runtime Instances is not available in every region. Supported:
# us-east-1, us-east-2, us-west-2, eu-central-1, eu-west-1, ap-south-1,
# ap-southeast-1, ap-southeast-2, ap-northeast-1.
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=

ECR_REPOSITORY_NAME=cursor-agentcore-worker
WORKER_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Container image
# ---------------------------------------------------------------------------

WORKER_IMAGE=cursor-agentcore-worker:local

# docker, or Finch (https://github.com/runfinch/finch). Makefile auto-detects
# `docker` then `finch` then /usr/local/bin/finch.
# CONTAINER_CLI=/usr/local/bin/finch

# Keep this linux/arm64. The Instances compute page lists x86_64 and arm64 support,
# but the container contract pages state ARM64 unconditionally and nothing says the
# image architecture may differ from the capacity provider operatingSystem. See
# OQ-1 in REQUIREMENTS.md. If you change this, change AGENTCORE_OPERATING_SYSTEM
# to match.
WORKER_PLATFORM=linux/arm64

# ---------------------------------------------------------------------------
# AgentCore resources
# ---------------------------------------------------------------------------

# Names take letters, digits, and underscores only, and must start with a letter.
AGENTCORE_CAPACITY_PROVIDER_NAME=cursor_worker_lab
AGENTCORE_RUNTIME_NAME=cursor_worker

AGENTCORE_OPERATING_SYSTEM=LINUX_ARM64

# Comma-separated. Size these like a CI runner for the target repository.
AGENTCORE_INSTANCE_TYPES=m7g.large,m7g.xlarge,c7g.large

# Persistent workspace volume, mounted at /mnt/workspace. It survives a session
# stop, so re-invoking the same session ID re-attaches the clone and caches.
AGENTCORE_WORKSPACE_VOLUME_SIZE_GIB=100

# 1209600 seconds is the 14-day maximum. The runtime maxLifetime must stay less
# than or equal to the capacity provider maxLifetime or CreateAgentRuntime fails.
AGENTCORE_MAX_LIFETIME=1209600
AGENTCORE_IDLE_INSTANCE_TIMEOUT=900

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Leave both empty to use the account default VPC and all of its subnets. Private
# subnets need NAT or equivalent egress: the worker dials Cursor outbound over
# HTTPS and pulls its image from ECR.
AGENTCORE_VPC_ID=
AGENTCORE_SUBNET_IDS=

# ---------------------------------------------------------------------------
# Session handle
# ---------------------------------------------------------------------------

# Sessions exist only after an invocation and cannot be listed, so the session ID
# is the only handle you get. `make agentcore-start-session` prints one; paste it
# here to make the status and stop targets work without arguments. Minimum 33
# characters.
AGENTCORE_SESSION_ID=
