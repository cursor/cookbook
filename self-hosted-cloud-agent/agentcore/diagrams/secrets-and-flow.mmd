%% Operator env + numbered path. Render: python3 diagrams/render_secrets_and_flow.py
%% Laptop Makefile: `-include .env` then `export`.
flowchart TB
  subgraph LAPTOP["1. Laptop — you export these"]
    E["cd self-hosted-cloud-agent/agentcore
cp .env.example .env
export CURSOR_API_KEY='key_...'
export CURSOR_GIT_TOKEN='github_pat_...'
export WORKER_REPOSITORY_URL='https://github.com/kaushalavardhanam/kaushalavardhanam.git'
export AWS_REGION=us-west-2
export CURSOR_WORKER_POOL_NAME=agentcore-platform-agents
export GH_PROJECT_TOKEN='github_pat_...'
export AGENTCORE_SESSION_ID='cursor-worker-&lt;uuid&gt;'"]
  end

  subgraph GHUB["2. GitHub Actions — sample repo"]
    S["gh secret set CURSOR_API_KEY --body \"$CURSOR_API_KEY\"
gh secret set GH_PROJECT_TOKEN --body \"$GH_PROJECT_TOKEN\"
env:
  CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
  GH_PROJECT_TOKEN: ${{ secrets.GH_PROJECT_TOKEN }}"]
  end

  subgraph AWS["3. Secrets Manager in the account — not Terraform state"]
    R["cursor-agentcore-worker-api-key  →  CURSOR_API_KEY
cursor-agentcore-worker-git-token  →  CURSOR_GIT_TOKEN
WORKER_REPOSITORY_URL=&lt;sample-repo git URL&gt;
CURSOR_WORKER_POOL_NAME=agentcore-platform-agents"]
  end

  subgraph WORKER["4. Worker — API key from adapter; git token from cursor-agentcore-worker-git-token"]
    W["GetSecretValue cursor-agentcore-worker-api-key → CURSOR_API_KEY
CURSOR_GIT_TOKEN from cursor-agentcore-worker-git-token
agent worker --pool start
git push + autoCreatePR using CURSOR_GIT_TOKEN"]
  end

  E -->|put-secret-value cursor-agentcore-worker-api-key| R
  E -->|put-secret-value cursor-agentcore-worker-git-token| R
