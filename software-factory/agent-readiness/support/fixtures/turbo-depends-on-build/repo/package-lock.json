{
  "name": "turbo-depends-on-build",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "turbo-depends-on-build",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@fx/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@fx/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/app": {
      "name": "@fx/app",
      "version": "1.0.0",
      "dependencies": {
        "@fx/core": "1.0.0"
      }
    },
    "packages/core": {
      "name": "@fx/core",
      "version": "1.0.0"
    }
  }
}
